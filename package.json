{
	"name": "portable-pg",
	"version": "0.0.0",
	"description": "Postgres 18 with pgvector as one movable directory, and a Node package that runs it.",
	"license": "MIT",
	"repository": "github:SagnikPradhan/portable-pg",
	"type": "module",
	"packageManager": "pnpm@11.25.0",
	"engines": {
		"node": ">=24"
	},
	"os": [
		"linux"
	],
	"bin": {
		"ppg": "./dist/cli.js"
	},
	"imports": {
		"#src/*": "./src/*.ts"
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"checksums.json"
	],
	"scripts": {
		"build": "rm -rf dist && tsc -p tsconfig.build.json",
		"check": "tsc --noEmit",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"lint": "eslint .",
		"postgres": "scripts/postgres.sh",
		"test": "vitest run",
		"prepare": "lefthook install"
	},
	"devDependencies": {
		"@commitlint/cli": "21.2.3",
		"@commitlint/config-conventional": "21.2.3",
		"@eslint/js": "10.0.1",
		"@tsconfig/strictest": "2.0.8",
		"@types/node": "24.19.2",
		"@types/pg": "8.23.1",
		"eslint": "10.12.0",
		"lefthook": "2.1.16",
		"pg": "8.23.1",
		"prettier": "3.9.9",
		"typescript": "6.0.2",
		"typescript-eslint": "8.71.0",
		"vitest": "5.0.3"
	}
}
